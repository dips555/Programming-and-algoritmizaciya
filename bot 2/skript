    report.append("Высота подъёма смеси: " + str(data.lift_height_m) + " м")
    report.append("Скорость потока: " + str(round(data.flow_velocity_ms, 2)) + " м/с")

    report.append("\n--- 2. ГИДРАВЛИЧЕСКИЙ РАСЧЁТ ---")

    # Числа Рейнольдса
    re_90 = calculate_reynolds_number(data, 90)
    re_60 = calculate_reynolds_number(data, 60)
    report.append("Число Рейнольдса (90°C): " + str(round(re_90, 2)))
    report.append("Число Рейнольдса (60°C): " + str(round(re_60, 2)))

    # Коэффициенты трения по Блазиусу
    lambda_90 = calculate_friction_factor_blasius(re_90)
    lambda_60 = calculate_friction_factor_blasius(re_60)
