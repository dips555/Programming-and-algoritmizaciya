}

# Физические константы
GRAVITY = 9.81  # Ускорение свободного падения, м/с²
STANDARD_PRESSURE = 101325  # Нормальное атмосферное давление, Па

# ========== 3. РАСЧЁТНЫЕ ФУНКЦИИ ========== #

def calculate_reynolds_number(data, temperature_c):
    """
    Расчёт числа Рейнольдса
    Re = ρ * v * D / μ
    """
    rho = data.mixture_density_kgm3
    v = data.flow_velocity_ms
    D = data.pipeline_diameter_m

    if temperature_c == 90:
        mu = data.dynamic_viscosity_at_90_pas
    else:
        mu = data.dynamic_viscosity_at_60_pas

    re = rho * v * D / mu
    return re

def calculate_friction_factor_blasius(re):
    """
    Коэффициент трения по формуле Блазиуса (для гладких труб, нережимный режим)
    λ = 0.3164 / Re^0.25
    """
    if re <= 0:
        return 0.015
    lambda_factor = 0.3164 / (re ** 0.25)
    return lambda_factor

def calculate_friction_factor_with_two_phase(lambda_single, two_phase_coefficient=1.2):
    """
    Коэффициент трения для двухфазной среды (по Локхарт-Маринелли)
    λ_two_phase = λ_single * K
    K — коэффициент увеличения (из фото: 1.2)
    """
    return lambda_single * two_phase_coefficient

def calculate_friction_loss_per_meter(data, lambda_factor):
    """
    Потери на трение на 1 метр длины, Па/м
    ΔP/м = λ * (ρ * v²) / (2 * D)
    """
    rho = data.mixture_density_kgm3
    v = data.flow_velocity_ms
    D = data.pipeline_diameter_m

    loss_per_m = lambda_factor * (rho * v * v) / (2 * D)
    return loss_per_m

def calculate_total_friction_loss(data, lambda_factor):
    """
    Потери на трение по всей длине, Па
    ΔP_friction = (ΔP/м) * L
    """
    loss_per_m = calculate_friction_loss_per_meter(data, lambda_factor)
    total_loss = loss_per_m * data.pipeline_length_m
    return total_loss

def calculate_local_resistance_loss(data):
    """
    Потери на местных сопротивлениях, Па
    ΔP_local = Σξ * (ρ * v²) / 2
    """
    rho = data.mixture_density_kgm3
    v = data.flow_velocity_ms

    # Суммируем коэффициенты с учётом количества
    sum_xi = 0
    for element, coeff in LOCAL_RESISTANCE_COEFFICIENTS.items():
        count = LOCAL_RESISTANCE_COUNTS.get(element, 1)
        sum_xi = sum_xi + coeff * count

    local_loss = sum_xi * (rho * v * v) / 2
    return local_loss, sum_xi

def calculate_hydrostatic_pressure(data):
    """
    Расчёт гидростатического давления
    Для газовой и жидкостной составляющей
    """
    # Гидростатика газовой составляющей
    # P_gas = ρ_gas * g * h, но в фото дано готовое значение
    gas_hydrostatic = 7.38

    # Процент сечения, занятый жидкостью (из фото: 5%)
    liquid_fraction = 0.05

    # Плотность воды (приближённо 1000 кг/м³)
    water_density = 1000

    # Гидростатика жидкостной составляющей
    liquid_hydrostatic = water_density * GRAVITY * data.lift_height_m * liquid_fraction

    return gas_hydrostatic, liquid_hydrostatic

def calculate_total_backpressure(data, lambda_factor):
    """
    Полное противодавление системы, кПа
    Сумма: трение по длине + местные сопротивления + гидростатика
    """
    friction_loss = calculate_total_friction_loss(data, lambda_factor)
    local_loss, sum_xi = calculate_local_resistance_loss(data)
    gas_hydro, liquid_hydro = calculate_hydrostatic_pressure(data)

    total_pa = friction_loss + local_loss + gas_hydro + liquid_hydro
    total_kpa = total_pa / 1000

    return total_kpa, {
        'friction_pa': friction_loss,
        'local_pa': local_loss,
        'gas_hydro_pa': gas_hydro,
        'liquid_hydro_pa': liquid_hydro,
        'sum_xi': sum_xi
    }

def calculate_mixture_heat_capacity(data):
    """
    Расчёт теплоёмкости смеси газов (кДж/м³)
    C_смеси = Σ (доля_i * C_i)
    Из фото 1000124201.jpg: результат 1.38
    """
    c_mixture = 0
    for gas, fraction in data.gas_composition.items():
        c_gas = data.gas_heat_capacity.get(gas, 1.0)
        c_mixture = c_mixture + fraction * c_gas
    return c_mixture

def calculate_heat_removed(data, gas_volume_m3_per_s=1.0):
    """
    Отводимая теплота (кДж/м³)
    Q = C_смеси * ΔT
    Из фото: 705.50 кДж/м³
    """
    c_mixture = calculate_mixture_heat_capacity(data)
    # ΔT = T_макс - T_ср (из фото: 600 - 345 = 255)
    delta_T = data.temp_max_c - data.temp_start_c
    heat = c_mixture * delta_T
    return heat

def calculate_heat_capacity_delta(data):
    """
    Теплоёмкость "дельта" (из фото: 510.97)
    """
    heat_removed = calculate_heat_removed(data)
    delta_T = data.temp_max_c - data.temp_start_c
    if delta_T > 0:
        return heat_removed / delta_T
    return heat_removed

def calculate_water_flow(data):
    """
    Расчёт расхода воды на охлаждение
    Из фото: 12.99 м³/ч
    """
    return data.recommended_water_flow_m3h

# ========== 4. ПРОВЕРКА ГРАНИЧНЫХ УСЛОВИЙ ========== #

def check_boundary_conditions(data, velocity_ms, backpressure_kpa):
    """
    Проверка ограничений:
    - Скорость потока не более 30 м/с
    - Противодавление не более 13 кПа
    """
    warnings = []

    if velocity_ms > 30:
        warnings.append(
            "СКОРОСТЬ ПОТОКА " + str(round(velocity_ms, 2)) + " м/с ПРЕВЫШАЕТ 30 м/с! Требуется увеличение диаметра.")
    else:
        warnings.append("Скорость потока " + str(round(velocity_ms, 2)) + " м/с в норме (не более 30)")

    if backpressure_kpa > 13:
        warnings.append("ПРОТИВОДАВЛЕНИЕ " + str(
            round(backpressure_kpa, 2)) + " кПа ПРЕВЫШАЕТ 13 кПа! Требуется пересмотр конфигурации.")
    else:
        warnings.append("Противодавление " + str(round(backpressure_kpa, 2)) + " кПа в норме (не более 13)")

    # Проверка мощности двигателя (если больше 800 кВт — отправка на почту)
    need_email = False
    if data.engine_power_kw >= 800:
        need_email = True
        warnings.append("Мощность двигателя " + str(
            data.engine_power_kw) + " кВт >= 800 кВт -> требуется отправка запроса на почту")

    return need_email, warnings

