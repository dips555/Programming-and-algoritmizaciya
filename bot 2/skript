    TWO_PHASE_COEFF = 1.2
    lambda_two_phase_90 = calculate_friction_factor_with_two_phase(lambda_90, TWO_PHASE_COEFF)
    lambda_two_phase_60 = calculate_friction_factor_with_two_phase(lambda_60, TWO_PHASE_COEFF)
    report.append("Коэффициент трения двухфазный (90°C): " + str(round(lambda_two_phase_90, 6)))
    report.append("Коэффициент трения двухфазный (60°C): " + str(round(lambda_two_phase_60, 6)))

    # Усреднённый коэффициент
    avg_lambda = 0.019
    report.append("Усреднённый коэффициент для магистрали: " + str(avg_lambda))

    # Потери на трение
    loss_per_m = calculate_friction_loss_per_meter(data, avg_lambda)
    total_friction = calculate_total_friction_loss(data, avg_lambda)
    report.append("Потери на трение на 1 м длины: " + str(round(loss_per_m, 2)) + " Па/м")
    report.append("Потери на трение по длине: " + str(round(total_friction, 2)) + " Па")

    report.append("\n--- 3. МЕСТНЫЕ СОПРОТИВЛЕНИЯ ---")
    local_loss, sum_xi = calculate_local_resistance_loss(data)
    report.append("Суммарный коэффициент местных сопротивлений: " + str(round(sum_xi, 2)))
    report.append("Потери на местных сопротивлениях: " + str(round(local_loss, 2)) + " Па")

    report.append("\n--- 4. ГИДРОСТАТИЧЕСКОЕ ДАВЛЕНИЕ ---")
    gas_hydro, liquid_hydro = calculate_hydrostatic_pressure(data)
    report.append("Гидростатика газовой составляющей: " + str(round(gas_hydro, 2)) + " Па")
    report.append("Гидростатика жидкостной составляющей: " + str(round(liquid_hydro, 2)) + " Па")

    report.append("\n--- 5. ПРОТИВОДАВЛЕНИЕ СИСТЕМЫ ---")
    total_backpressure, details = calculate_total_backpressure(data, avg_lambda)
    report.append("Противодавление системы: " + str(round(total_backpressure, 2)) + " кПа")
    report.append(" (вкл. трение " + str(round(details['friction_pa'], 2)) + " Па + местные " + str(
        round(details['local_pa'], 2)) + " Па + гидростатика)")

    report.append("\n--- 6. ТЕПЛОВОЙ РАСЧЁТ (по данным фото 1000124201.jpg) ---")

    # Состав газов
    report.append("Состав выхлопных газов (объёмные доли):")
    for gas, fraction in data.gas_composition.items():
        report.append(" • " + gas + ": " + str(fraction * 100) + "%")

    c_mixture = calculate_mixture_heat_capacity(data)
    report.append("Теплоёмкость смеси: " + str(round(c_mixture, 3)) + " кДж/м³")

    heat_removed = calculate_heat_removed(data)
    report.append("Отводимая теплота: " + str(round(heat_removed, 2)) + " кДж/м³")

    heat_delta = calculate_heat_capacity_delta(data)
    report.append("Теплоёмкость 'дельта': " + str(round(heat_delta, 2)))

    report.append("\n--- 7. ВОДЯНОЕ ОХЛАЖДЕНИЕ ---")
    report.append("Теплоёмкость воды: " + str(data.water_heat_capacity) + " кДж/(кг·К)")
    report.append("Температура воды на входе: " + str(data.water_temp_inlet_c) + " °C")
    report.append("Температура воды на выходе: " + str(data.water_temp_outlet_c) + " °C")
    report.append("Номинальный расход воды: " + str(round(calculate_water_flow(data), 2)) + " м³/ч")
    report.append("Запас на испарение: " + str(data.vaporization_reserve_m3h) + " м³/ч")
    report.append("Рекомендуемый расход воды: " + str(data.recommended_water_flow_m3h) + " м³/ч")

    report.append("\n--- 8. ПРОВЕРКА ГРАНИЧНЫХ УСЛОВИЙ ---")
    need_email, boundary_warnings = check_boundary_conditions(data, data.flow_velocity_ms, total_backpressure)
    for w in boundary_warnings:
        report.append("• " + w)

    if need_email:
        report.append("\n[ВНИМАНИЕ] Требуется отправка запроса на почту (превышены лимиты)")

    report.append("\n--- 9. РЕКОМЕНДАЦИИ ---")
    report.append("• При превышении скорости 30 м/с увеличить диаметр трубопровода")
    report.append("• При противодавлении выше 13 кПа произвести пересмотр конфигурации")
    report.append("• Обеспечить уклон магистрали не менее 1% для отвода конденсата")
    report.append("• Установить конденсатоотводчики в нижних точках системы")

    report.append("\n" + "=" * 70)
    report.append("РАСЧЁТ ВЫПОЛНЕН НА ОСНОВЕ ПРЕДОСТАВЛЕННОЙ МЕТОДИКИ")
    report.append("=" * 70)

    return "\n".join(report)

