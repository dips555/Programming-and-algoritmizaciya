}

# Количество каждого элемента
LOCAL_RESISTANCE_COUNTS = {
    'Водяной замок': 1,
    'Гусь или глушитель': 1,
    'Задвижка (захлопка)': 1,
    'Колено 90 градусов (R=1.5D)': 3,
    'Отвод 45 градусов': 2,
